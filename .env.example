# UpgradeLens environment template. Copy to `.env` and fill real values.
# NEVER commit `.env`. Stage 0-1 run fully offline without any secret.

# Logging level: DEBUG, INFO, WARNING, ERROR
UPGRADELENS_LOG_LEVEL=INFO

# === Stage 5 model gateway (real LLM) ===
# The model gateway has three modes:
#   fake    -> offline canned output (DEFAULT; deterministic, no network, no cost)
#   replay  -> plays back recorded model responses (offline, deterministic)
#   live    -> calls a real OpenAI-compatible endpoint (e.g. 阿里云百炼)
# Stage 0-1 and the Streamlit demo default to "fake" so CI / single tests stay
# offline and free. Switch to "live" only when you want a real model.
UPGRADELENS_MODEL_MODE=fake

# OpenAI-compatible base url. For 阿里云百炼 use the compatible-mode endpoint:
UPGRADELENS_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Any 百炼 model id, e.g. qwen-plus / qwen-flash / qwen-max.
UPGRADELENS_MODEL_NAME=qwen-plus

# Real API key for live mode. NEVER commit. Not needed for fake/replay.
UPGRADELENS_MODEL_API_KEY=
#
# Reasoning models (e.g. qwen3.7-plus / qwen-plus-thinking) reject
# function_calling's tool_choice in thinking mode and waste time "thinking",
# which makes structured extraction fail or time out. Set true for such models
# so the gateway disables thinking for every structured call.
# Leave false for non-reasoning models (qwen-plus, qwen-max, qwen-flash...).
UPGRADELENS_MODEL_DISABLE_THINKING=false
#
# After filling the key, verify the endpoint with one tiny structured call:
#   uv run python -m upgradelens.cli llm-check --mode live
# It prints mode / model / latency / real token usage, and reports
# called_real_api=false whenever no request actually left the process.

# === GitHub (comment-pr) ===
# Token used by `upgradelens comment-pr` to post the assessment as a PR/issue
# comment. A fine-grained PAT with `pull_requests: write` (or `issues: write`)
# is enough. Falls back to this env var when --token is not passed on the CLI.
GITHUB_TOKEN=
