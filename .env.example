# UpgradeLens environment template. Copy to `.env` and fill real values.
# NEVER commit `.env`. Stage 0-1 run fully offline without any secret.

# Logging level: DEBUG, INFO, WARNING, ERROR
UPGRADELENS_LOG_LEVEL=INFO

# LLM API key (NOT required until the LLM stage, do not set for stage 0-1)
# UPGRADELENS_API_KEY=
