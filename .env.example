# UpgradeLens environment template. Copy to `.env` and fill real values.
# NEVER commit `.env`. Stage 0-1 run fully offline without any secret.

# Logging level: DEBUG, INFO, WARNING, ERROR
UPGRADELENS_LOG_LEVEL=INFO

# === Stage 5 model gateway (real LLM) ===
# The model gateway has three modes:
#   fake    -> offline canned output (DEFAULT; deterministic, no network, no cost)
#   replay  -> plays back recorded model responses (offline, deterministic)
#   live    -> calls a real OpenAI-compatible endpoint (e.g. 阿里云百炼)
# Stage 0-1 and the Streamlit demo default to "fake" so CI / single tests stay
# offline and free. Switch to "live" only when you want a real model.
UPGRADELENS_MODEL_MODE=fake

# OpenAI-compatible base url. For 阿里云百炼 use the compatible-mode endpoint:
UPGRADELENS_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Any 百炼 model id, e.g. qwen-plus / qwen-flash / qwen-max.
UPGRADELENS_MODEL_NAME=qwen-plus

# Real API key for live mode. NEVER commit. Not needed for fake/replay.
UPGRADELENS_MODEL_API_KEY=
